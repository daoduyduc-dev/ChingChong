{
  "name": "ky-vien",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run typecheck && npm run build --workspace client",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "test:ui": "node scripts/test.mjs --config vitest.ui.config.ts",
    "db:generate": "npm run db:generate --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:local": "node scripts/postgres.mjs",
    "start": "npm run start --workspace server",
    "preview": "npm run preview --workspace client"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  }
}
