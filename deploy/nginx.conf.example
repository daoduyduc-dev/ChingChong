# Substitute domain, certificate paths, and release root before nginx -t.
# This template has NOT been executed against an installed nginx/TLS endpoint.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80;
    server_name chess.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name chess.example.com;
    ssl_certificate /etc/letsencrypt/live/chess.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chess.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/kyvien/current/client/dist;
    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Permissions-Policy "camera=(self), microphone=(self)" always;
    location /api/ {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 35s;
        # Do not log reset links, OAuth codes, cookies, or authorization headers.
        access_log off;
    }
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
        access_log off;
    }
    location = /sw.js { add_header Cache-Control "no-cache, no-store"; }
    location = /index.html { add_header Cache-Control "no-cache, no-store"; access_log off; }
    location = /registerSW.js { add_header Cache-Control "no-cache"; }
    location = /manifest.webmanifest { add_header Cache-Control "no-cache"; }
    location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; try_files $uri =404; }
    location / { access_log off; try_files $uri $uri/ /index.html; }
}
